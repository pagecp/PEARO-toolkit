# Copier ce fichier vers config_input/pearo.env et adapter les valeurs localement.

# Répertoire racine des données temporaires PEARO sur le scratch Belenos.
PEARO_DATA_ROOT="${WORKDIR}/PEARO_data"

# Répertoire persistant contenant l'état du workflow et les marqueurs de reprise.
PEARO_STATE_ROOT="${HOME}/.pearo-toolkit-state"

# Fichier contenant les dates à traiter, une par ligne au format YYYY-MM-DD.
PEARO_DAYS_FILE="${PWD}/config_input/lof_days.txt"

# Chemin du script initialisant Conda dans les jobs Slurm.
PEARO_CONDA_SH="/home/ext/cf/cglo/moinemp/SAVE/miniforge3/etc/profile.d/conda.sh"

# Nom de l'environnement Conda contenant les dépendances PEARO.
PEARO_CONDA_ENV="pearo_env"

# Nombre de membres de la prévision d'ensemble traités pour chaque journée.
PEARO_NB_MEMBERS=16

# Nombre maximal de fichiers soumis ensemble à hstage et hfstat.
PEARO_PRESTAGE_CHUNK_SIZE=300

# Délai en secondes entre deux vérifications du statut de pré-staging.
PEARO_PRESTAGE_POLL_SECONDS=120

# Nombre maximal de vérifications avant l'échec du pré-staging.
PEARO_PRESTAGE_MAX_POLLS=180

# Partition Slurm utilisée pour transférer les GRIB de Hendrix vers Belenos.
PEARO_TRANSFER_PARTITION="transfert"

# Temps maximal accordé au transfert d'une journée.
PEARO_TRANSFER_TIME="02:00:00"

# Partition Slurm utilisée pour calculer les fichiers journaliers de tasmax.
PEARO_PREPROCESS_PARTITION="normal256"

# Temps maximal accordé au prétraitement d'une journée.
PEARO_PREPROCESS_TIME="01:00:00"

# Partition Slurm utilisée pour envoyer les NetCDF vers le Cerfacs.
PEARO_SEND_PARTITION="transfert"

# Temps maximal accordé à l'envoi des résultats d'une journée.
PEARO_SEND_TIME="00:10:00"

# Active (1) ou désactive (0) l'envoi des NetCDF vers le Cerfacs.
PEARO_DO_SEND=1

# Supprime (1) ou conserve (0) les GRIB après la réussite du traitement.
PEARO_CLEAN_ORIG=1

# Nom SSH du serveur Cerfacs destinataire (à renseigner localement).
PEARO_SEND_HOST=""

# Compte SSH utilisé sur le serveur Cerfacs destinataire (à renseigner localement).
PEARO_SEND_USER=""

# Répertoire racine de destination sur le serveur Cerfacs (à renseigner localement).
PEARO_SEND_DEST_ROOT=""
